/* LimpiaPro PySide6 stylesheet.
   Color tokens are substituted at runtime by limpiapro/ui/theme.py:
   %BG% %SIDEBAR% %CARD% %CARD_ALT% %CARD_HOVER% %BORDER% %TEXT% %MUTED%
   %FAINT% %INPUT% %CONSOLE% %SUCCESS% %SUCCESS_TEXT% %WARNING% %ERROR%
   %ERROR_SOFT% %ERROR_SOFT_HOVER% %ERROR_BORDER% %WARNING_SOFT%
   %WARNING_SOFT_HOVER% %WARNING_BORDER% %ACCENT% %ACCENT_HOVER% */

* {
    outline: none;
}

QMainWindow, QDialog, QMessageBox, QWidget {
    background-color: %BG%;
    color: %TEXT%;
    font-family: %FONT_STACK%;
    font-size: 13px;
}

/* Labels and checkboxes must not paint their own background: the global
   QWidget rule above would otherwise draw a %BG% box around every label
   sitting on a differently-colored surface (sidebar, cards, rows). */
QLabel, QCheckBox {
    background: transparent;
}

/* ------------------------------------------------------------- sidebar */

QFrame#sidebar {
    background-color: %SIDEBAR%;
    border-right: 1px solid %BORDER%;
}

QLabel#appLogo {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: %TEXT%;
    background: transparent;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    color: %TEXT%;
    font-size: 14px;
}

QPushButton#navButton:hover {
    background: %CARD_HOVER%;
}

QPushButton#navButton:checked {
    background: %ACCENT%;
    color: #ffffff;
    font-weight: 600;
}

/* ------------------------------------------------------------ headers */

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.2px;
    color: %TEXT%;
    background: transparent;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: %MUTED%;
    background: transparent;
}

QLabel#mutedText {
    color: %MUTED%;
    background: transparent;
}

QLabel#statusText {
    color: %MUTED%;
    background: transparent;
}

QLabel#totalText {
    font-size: 13px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

QLabel#successText {
    color: %SUCCESS_TEXT%;
    background: transparent;
}

/* ----------------------------------------------------- category rows */

QWidget#catRow {
    background-color: %CARD_ALT%;
    border: 1px solid %BORDER%;
    border-radius: 10px;
}

QLabel#catTitle {
    font-size: 14px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

QLabel#catDesc {
    font-size: 11px;
    color: %MUTED%;
    background: transparent;
}

QLabel#catSize {
    font-size: 14px;
    font-weight: 600;
    color: %SUCCESS_TEXT%;
    background: transparent;
}

QLabel#catCount {
    font-size: 10px;
    color: %FAINT%;
    background: transparent;
}

/* ------------------------------------------------------- settings page */

QFrame#settingCard {
    background-color: %CARD_ALT%;
    border: 1px solid %BORDER%;
    border-radius: 10px;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

/* ------------------------------------------------------------ buttons */

QPushButton {
    background-color: %INPUT%;
    border: 1px solid %BORDER%;
    border-radius: 6px;
    padding: 7px 14px;
    color: %TEXT%;
}

QPushButton:focus {
    border-color: %ACCENT%;
}

QPushButton:hover {
    background-color: %CARD_HOVER%;
}

QPushButton:pressed {
    background-color: %CARD%;
}

QPushButton:disabled {
    color: %FAINT%;
    background-color: %CARD%;
    border-color: %BORDER%;
}

QPushButton[kind="primary"] {
    background-color: %ACCENT%;
    border: 1px solid %ACCENT%;
    color: #ffffff;
    font-weight: 600;
}

QPushButton[kind="primary"]:hover {
    background-color: %ACCENT_HOVER%;
    border-color: %ACCENT_HOVER%;
}

QPushButton[kind="danger"] {
    background-color: %ERROR_SOFT%;
    border: 1px solid %ERROR_BORDER%;
    color: %ERROR%;
}

QPushButton[kind="danger"]:hover {
    background-color: %ERROR_SOFT_HOVER%;
}

QPushButton[kind="warning"] {
    background-color: %WARNING_SOFT%;
    border: 1px solid %WARNING_BORDER%;
    color: %WARNING%;
}

QPushButton[kind="warning"]:hover {
    background-color: %WARNING_SOFT_HOVER%;
}

QPushButton[kind="success"] {
    background-color: %SUCCESS%;
    border: 1px solid %SUCCESS%;
    color: #ffffff;
}

QPushButton[kind="success"]:hover {
    background-color: %SUCCESS%;
}

/* ------------------------------------------------------------ checkbox */

QCheckBox {
    spacing: 8px;
    color: %TEXT%;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid %FAINT%;
    background: %CARD%;
}

QCheckBox::indicator:hover {
    border-color: %ACCENT%;
}

QCheckBox::indicator:checked {
    background-color: %ACCENT%;
    border-color: %ACCENT%;
}

/* ------------------------------------------------------------ progress */

QProgressBar {
    border: none;
    border-radius: 5px;
    background-color: %INPUT%;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    border-radius: 5px;
    background-color: %ACCENT%;
}

/* -------------------------------------------------------------- scroll */

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: %FAINT%;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: %MUTED%;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: %FAINT%;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --------------------------------------------------------------- tree */

QTreeWidget {
    background-color: %CARD%;
    alternate-background-color: %CARD_ALT%;
    border: 1px solid %BORDER%;
    border-radius: 6px;
    padding: 4px;
    color: %TEXT%;
    show-decoration-selected: 0;
}

QTreeWidget::item {
    padding: 4px 2px;
}

QTreeWidget::item:selected {
    background-color: %ACCENT%;
    color: #ffffff;
}

QHeaderView::section {
    background-color: %SIDEBAR%;
    color: %MUTED%;
    border: none;
    border-bottom: 1px solid %BORDER%;
    padding: 5px 8px;
    font-weight: 600;
}

/* ---------------------------------------------------------------- tabs */

QTabWidget::pane {
    border: 1px solid %BORDER%;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: %MUTED%;
    padding: 7px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: %TEXT%;
    border-bottom: 2px solid %ACCENT%;
}

QTabBar::tab:hover {
    color: %TEXT%;
}

/* ------------------------------------------------------------- inputs */

QComboBox, QLineEdit {
    background-color: %INPUT%;
    border: 1px solid %BORDER%;
    border-radius: 6px;
    padding: 6px 10px;
    color: %TEXT%;
}

QComboBox:hover, QLineEdit:hover {
    border-color: %ACCENT%;
}

QComboBox:focus, QLineEdit:focus {
    border: 1px solid %ACCENT%;
    background-color: %CARD%;
}

QComboBox QAbstractItemView {
    background-color: %INPUT%;
    border: 1px solid %BORDER%;
    selection-background-color: %ACCENT%;
    selection-color: #ffffff;
}

QPlainTextEdit {
    background-color: %CONSOLE%;
    border: 1px solid %BORDER%;
    border-radius: 6px;
    color: %MUTED%;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 12px;
    padding: 4px;
}

QToolTip {
    background-color: %INPUT%;
    color: %TEXT%;
    border: 1px solid %BORDER%;
    padding: 4px 8px;
}

/* ---------------------------------------------------------- dialogs */

QMessageBox {
    background-color: %BG%;
    min-width: 460px;
}

QMessageBox QLabel {
    font-size: 13px;
    padding-right: 8px;
}

QMessageBox QPushButton {
    min-width: 104px;
    padding: 8px 16px;
}

QLabel#dlgHeading {
    font-size: 17px;
    font-weight: 700;
    color: %TEXT%;
    background: transparent;
}

QLabel#dlgSubtle {
    font-size: 12px;
    color: %MUTED%;
    background: transparent;
}

QLabel#dlgItem {
    font-size: 13px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

QLabel#dlgItemRight {
    font-size: 12px;
    color: %SUCCESS_TEXT%;
    background: transparent;
}

QFrame#noteCard {
    background-color: %WARNING_SOFT%;
    border: 1px solid %WARNING_BORDER%;
    border-radius: 8px;
}

QFrame#noteCard[kind="danger"] {
    background-color: %ERROR_SOFT%;
    border: 1px solid %ERROR_BORDER%;
}

QLabel#noteText {
    font-size: 12px;
    color: %TEXT%;
    background: transparent;
}
