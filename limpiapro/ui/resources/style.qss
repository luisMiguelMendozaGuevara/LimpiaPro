/* LimpiaPro PySide6 stylesheet.
   Color tokens are substituted at runtime by limpiapro/ui/theme.py:
   %BG% %SIDEBAR% %CARD% %CARD_HOVER% %BORDER% %TEXT% %MUTED% %FAINT%
   %INPUT% %ACCENT% %ACCENT_HOVER% */

* {
    outline: none;
}

QMainWindow, QDialog, QMessageBox, QWidget {
    background-color: %BG%;
    color: %TEXT%;
    font-family: "Segoe UI";
    font-size: 13px;
}

/* ------------------------------------------------------------- sidebar */

QFrame#sidebar {
    background-color: %SIDEBAR%;
    border-right: 1px solid %BORDER%;
}

QLabel#appLogo {
    font-size: 22px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

QLabel#appVersion {
    color: %FAINT%;
    font-size: 11px;
    background: transparent;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    color: %MUTED%;
    font-size: 13px;
}

QPushButton#navButton:hover {
    background: %CARD_HOVER%;
}

QPushButton#navButton:checked {
    background: %ACCENT%;
    color: #ffffff;
    font-weight: 600;
}

/* -------------------------------------------------------------- cards */

QFrame#card {
    background-color: %CARD%;
    border: 1px solid %BORDER%;
    border-radius: 10px;
}

QFrame#card:hover {
    border-color: %FAINT%;
}

QLabel#cardTitle {
    font-size: 14px;
    font-weight: 600;
    color: %TEXT%;
    background: transparent;
}

QLabel#cardDesc {
    font-size: 11px;
    color: %MUTED%;
    background: transparent;
}

QLabel#cardSize {
    font-size: 13px;
    font-weight: 600;
    color: %SUCCESS%;
    background: transparent;
}

QLabel#cardFiles {
    font-size: 10px;
    color: %FAINT%;
    background: transparent;
}

QLabel#pageTitle {
    font-size: 20px;
    font-weight: 700;
    color: %TEXT%;
    background: transparent;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: %MUTED%;
    background: transparent;
}

QLabel#statValue {
    font-size: 24px;
    font-weight: 700;
    color: %TEXT%;
    background: transparent;
}

QLabel#statLabel {
    font-size: 11px;
    color: %MUTED%;
    background: transparent;
}

QLabel#statusText {
    color: %MUTED%;
    background: transparent;
}

QLabel#successText {
    color: %SUCCESS%;
    background: transparent;
}

QLabel#errorText {
    color: %ERROR%;
    background: transparent;
}

/* ------------------------------------------------------------ buttons */

QPushButton {
    background-color: %INPUT%;
    border: 1px solid %BORDER%;
    border-radius: 8px;
    padding: 8px 14px;
    color: %TEXT%;
}

QPushButton:hover {
    background-color: %CARD_HOVER%;
}

QPushButton:pressed {
    background-color: %SIDEBAR%;
}

QPushButton:disabled {
    color: %FAINT%;
    background-color: %CARD%;
    border-color: %BORDER%;
}

QPushButton[kind="primary"] {
    background-color: %ACCENT%;
    border: 1px solid %ACCENT%;
    color: #ffffff;
    font-weight: 600;
}

QPushButton[kind="primary"]:hover {
    background-color: %ACCENT_HOVER%;
    border-color: %ACCENT_HOVER%;
}

QPushButton[kind="primary"]:disabled {
    background-color: %INPUT%;
    border-color: %INPUT%;
    color: %FAINT%;
}

QPushButton[kind="danger"] {
    background-color: %ERROR_SOFT%;
    border: 1px solid %ERROR_BORDER%;
    color: %ERROR%;
}

QPushButton[kind="danger"]:hover {
    background-color: %ERROR_SOFT_HOVER%;
}

/* ------------------------------------------------------------ checkbox */

QCheckBox {
    spacing: 8px;
    color: %TEXT%;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid %FAINT%;
    background: %CARD%;
}

QCheckBox::indicator:hover {
    border-color: %ACCENT%;
}

QCheckBox::indicator:checked {
    background-color: %ACCENT%;
    border-color: %ACCENT%;
}

/* ----------------------------------------------------------- progress */

QProgressBar {
    border: none;
    border-radius: 5px;
    background-color: %INPUT%;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    border-radius: 5px;
    background-color: %ACCENT%;
}

/* ------------------------------------------------------------- scroll */

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: %FAINT%;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: %MUTED%;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: %FAINT%;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --------------------------------------------------------------- tree */

QTreeWidget {
    background-color: %CARD%;
    alternate-background-color: %CARD_ALT%;
    border: 1px solid %BORDER%;
    border-radius: 8px;
    padding: 4px;
    color: %TEXT%;
}

QTreeWidget::item {
    padding: 6px 4px;
    border-radius: 6px;
}

QTreeWidget::item:selected {
    background-color: %INPUT%;
    color: %TEXT%;
}

QHeaderView::section {
    background-color: %INPUT%;
    color: %MUTED%;
    border: none;
    border-bottom: 1px solid %BORDER%;
    padding: 6px 8px;
    font-weight: 600;
}

/* ------------------------------------------------------------- inputs */

QComboBox, QLineEdit {
    background-color: %CARD%;
    border: 1px solid %BORDER%;
    border-radius: 8px;
    padding: 7px 10px;
    color: %TEXT%;
}

QComboBox:hover, QLineEdit:hover {
    border-color: %ACCENT%;
}

QComboBox QAbstractItemView {
    background-color: %CARD%;
    border: 1px solid %BORDER%;
    selection-background-color: %ACCENT%;
    selection-color: #ffffff;
}

QToolTip {
    background-color: %CARD%;
    color: %TEXT%;
    border: 1px solid %BORDER%;
    padding: 4px 8px;
}

/* -------------------------------------------------------------- misc */

QGroupBox {
    border: 1px solid %BORDER%;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    color: %MUTED%;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QPlainTextEdit {
    background-color: %SIDEBAR%;
    border: 1px solid %BORDER%;
    border-radius: 8px;
    color: %MUTED%;
    font-family: "Consolas";
    font-size: 12px;
}
